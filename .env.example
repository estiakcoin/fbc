# Copy this file to .env for local development, or set these in your host's
# environment variable settings (Netlify: Site settings > Environment variables).

DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Email sending (Resend) — without these, contact form / tournament application /
# PIN reset emails are silently skipped (the app still works, just no emails go out).
RESEND_API_KEY=""
ADMIN_EMAIL_FROM="Fantastic FC Admin <onboarding@resend.dev>"
